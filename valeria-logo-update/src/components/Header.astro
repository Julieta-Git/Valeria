---
import Logo from './Logo.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/galeria', label: 'Galería' },
  { href: '/consejos', label: 'Conocé tu cabello' },
  { href: '/sobre-valeria', label: 'Sobre Valeria' },
  { href: '/contacto', label: 'Contacto' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="container site-header__inner">
    <Logo />
    <nav class="site-nav" id="site-nav" aria-label="Principal">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <a href="/reservar" class="btn btn--primary btn--small site-nav__cta">Reservar turno</a>
    </nav>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Abrir menú</span>
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
    </button>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 40; background: rgba(13, 11, 12, 0.92); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--s5); height: 5.25rem; }
  .site-nav { display: flex; align-items: center; gap: var(--s6); }
  .site-nav ul { display: flex; gap: var(--s5); list-style: none; margin: 0; padding: 0; }
  .site-nav ul a { text-decoration: none; font-size: 0.9375rem; padding-block: var(--s2); }
  .site-nav ul a[aria-current='page'] { text-decoration: underline; text-decoration-color: var(--accent-text); text-decoration-thickness: 2px; text-underline-offset: 0.5em; }
  .menu-btn { display: none; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center; background: transparent; color: var(--text); border: 1px solid var(--line); border-radius: var(--radius-s); cursor: pointer; }

  @media (max-width: 60rem) {
    .menu-btn { display: inline-flex; }
    .site-nav {
      display: none; position: fixed; inset: calc(5.25rem + 1px) 0 0 0; z-index: 39;
      flex-direction: column; align-items: stretch; gap: var(--s6);
      background: var(--bg); padding: var(--s6) var(--gutter); overflow-y: auto;
    }
    .site-nav.is-open { display: flex; }
    .site-nav ul { flex-direction: column; gap: 0; }
    .site-nav ul a { display: block; font-family: var(--font-display); font-size: 1.75rem; padding-block: var(--s3); border-bottom: 1px solid var(--line); }
    .site-nav__cta { width: 100%; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  const label = btn?.querySelector('.visually-hidden');
  function setOpen(open: boolean) {
    if (!btn || !nav) return;
    btn.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (label) label.textContent = open ? 'Cerrar menú' : 'Abrir menú';
  }
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { setOpen(false); btn.focus(); }
  });
  nav?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
</script>
