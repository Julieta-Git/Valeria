---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Base title="Contacto y ubicación" description={`Dirección, horarios y WhatsApp de ${site.nombre} en ${site.ciudad}.`}>
  <section class="container contact">
    <div class="stack">
      <p class="eyebrow">Contacto</p>
      <h1>Vení a <span class="script">conocernos</span></h1>
      <dl class="data">
        <div><dt>Dirección</dt><dd>{site.direccion}, {site.ciudad}</dd></div>
        <div><dt>WhatsApp</dt><dd><WhatsAppButton /></dd></div>
        <div><dt>Horarios</dt><dd>{site.horarios.dias}<br />Mañana {site.horarios.manana} · Tarde {site.horarios.tarde}<br /><span class="muted small">{site.horarios.nota}</span></dd></div>
        <div><dt>A domicilio</dt><dd>{site.domicilio}</dd></div>
        <div><dt>Medios de pago</dt><dd>{site.mediosDePago.join(', ')}</dd></div>
        <div><dt>Redes</dt><dd>{site.redes.map((r) => <a href={r.url || '#'} target="_blank" rel="noopener">{r.nombre} {r.usuario}</a>)}</dd></div>
      </dl>
      <div class="ctas">
        <a href="/reservar" class="btn btn--primary">Reservar turno</a>
        {site.mapsUrl && <a href={site.mapsUrl} class="btn btn--ghost" target="_blank" rel="noopener">Abrir en Google Maps</a>}
      </div>
    </div>
    <div class="map" role="img" aria-label="Mapa pendiente">
      <span>Mapa · se agrega cuando tengamos el link de Google Maps</span>
    </div>
  </section>
</Base>
<style>
  .contact { display: grid; gap: var(--s7); padding-block: var(--s8) var(--section); }
  @media (min-width: 60rem) { .contact { grid-template-columns: 1fr 1fr; gap: var(--s9); } }
  .contact .stack { gap: var(--s5); }
  .data { margin: 0; display: grid; gap: 0; }
  .data > div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s4); padding-block: var(--s4); border-bottom: 1px solid var(--line); }
  .data dt { color: var(--text-soft); font-size: var(--fs-small); }
  .data dd { margin: 0; }
  @media (max-width: 30rem) { .data > div { grid-template-columns: 1fr; gap: var(--s1); } }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--s3); }
  .map { min-height: 22rem; display: flex; align-items: center; justify-content: center; text-align: center; padding: var(--s6); background: var(--placeholder); color: var(--text-soft); font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; }
</style>
