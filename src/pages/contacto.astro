---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---
<Base title="Contacto y ubicación" description={`Dirección, horarios y WhatsApp de ${site.nombre} en ${site.ciudad}.`}>
  <section class:list={['container contact', { 'contact--sin-mapa': !site.mapsUrl }]}>
    <div class="stack">
      <h1>Vení a <span class="script">conocernos</span></h1>
      <dl class="data">
        <div><dt>Zona</dt><dd>{site.direccion}, {site.ciudad}</dd></div>
        <div><dt>WhatsApp</dt><dd><WhatsAppButton /></dd></div>
        <div><dt>Horarios</dt><dd>{site.horarios.dias}<br />Mañana {site.horarios.manana} · Tarde {site.horarios.tarde}<br /><span class="muted small">{site.horarios.nota}</span></dd></div>
        <div><dt>A domicilio</dt><dd>{site.domicilio}</dd></div>
        <div><dt>Medios de pago</dt><dd>{site.mediosDePago.join(', ')}</dd></div>
        <div><dt>Redes</dt><dd>{site.redes.map((r) => <a href={r.url || '#'} target="_blank" rel="noopener">{r.nombre} {r.usuario}</a>)}</dd></div>
      </dl>
      <div class="ctas">
        <a href="/reservar" class="btn btn--primary">Reservar turno</a>
        {site.mapsUrl && <a href={site.mapsUrl} class="btn btn--ghost" target="_blank" rel="noopener">Abrir en Google Maps</a>}
      </div>
    </div>
    {site.mapsUrl && (
      <a class="map" href={site.mapsUrl} target="_blank" rel="noopener">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
        <span class="map__place">{site.direccion}, {site.ciudad}</span>
        <span class="link-arrow">Ver la ubicación en Google Maps</span>
      </a>
    )}
  </section>
</Base>
<style>
  .contact { display: grid; gap: var(--s7); padding-block: var(--s8) var(--section); }
  @media (min-width: 60rem) { .contact { grid-template-columns: 1fr 1fr; gap: var(--s9); } }
  @media (min-width: 60rem) { .contact--sin-mapa { grid-template-columns: minmax(0, 44rem); } }
  .contact .stack { gap: var(--s5); }
  .data { margin: 0; display: grid; gap: 0; }
  .data > div { display: grid; grid-template-columns: 9rem 1fr; gap: var(--s4); padding-block: var(--s4); border-bottom: 1px solid var(--line); }
  .data dt { color: var(--text-soft); font-size: var(--fs-small); }
  .data dd { margin: 0; }
  .data dd > a:not(.btn) { display: inline-flex; align-items: center; min-height: 2.75rem; }
  @media (max-width: 30rem) { .data > div { grid-template-columns: 1fr; gap: var(--s1); } }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--s3); }
  .map {
    min-height: 22rem; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--s3);
    text-align: center; padding: var(--s6); color: var(--text); text-decoration: none;
    background: radial-gradient(circle at 50% 42%, var(--accent-glow), transparent 55%), var(--surface);
    border: 1px solid var(--line); transition: border-color 0.2s var(--ease);
  }
  .map svg { color: var(--accent-text); }
  .map__place { font-family: var(--font-display); font-size: var(--fs-h3); }
  a.map:hover { border-color: var(--accent-text); color: var(--text); }
</style>
