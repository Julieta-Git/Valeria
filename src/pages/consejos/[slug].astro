---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { enlaceReserva } from '../../lib/whatsapp';

export async function getStaticPaths() {
  const consejos = await getCollection('consejos');
  return consejos.map((c) => ({ params: { slug: c.id }, props: { consejo: c } }));
}
const { consejo } = Astro.props;
const d = consejo.data;
const { Content } = await render(consejo);
const servicios = (await Promise.all(d.servicios.map((id) => getEntry('servicios', id)))).filter(Boolean);
const principal = servicios[0];
const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titulo,
  description: d.resumen,
  datePublished: d.fecha.toISOString(),
  author: { '@type': 'Person', name: 'Valeria' },
  publisher: { '@type': 'HairSalon', name: site.nombre },
}];
---
<Base title={d.titulo} description={d.resumen} schema={schema}>
  <article class="container art">
    <nav aria-label="Ruta" class="small muted"><a href="/consejos">Conocé tu cabello</a> / {d.tema}</nav>
    <header class="stack art__head">
      <p class="tag">{d.tema}</p>
      <h1>{d.titulo}</h1>
      <p class="lead">{d.resumen}</p>
      {!d.revisado && <p class="small"><span class="pendiente">Borrador: falta la revisión de Valeria</span></p>}
    </header>
    <div class="prose"><Content /></div>
    {principal && (
      <aside class="art__cta">
        <p>¿Querés que Valeria vea tu caso?</p>
        <a class="btn btn--primary" href={enlaceReserva(principal.id)}>Reservar {principal.data.nombre.toLowerCase()}</a>
      </aside>
    )}
    {servicios.length > 0 && (
      <p class="small muted">Servicios relacionados: {servicios.map((s, i) => s && <>{i > 0 && ' · '}<a href={`/servicios/${s.id}`}>{s.data.nombre}</a></>)}</p>
    )}
  </article>
</Base>
<style>
  .art { max-width: 48rem; padding-block: var(--s6) var(--section); display: flex; flex-direction: column; gap: var(--s7); }
  .art nav a { color: var(--text-soft); }
  .art__head { gap: var(--s4); }
  .art__cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s4); padding: var(--s6); border: 1px solid var(--line); background: var(--surface); }
  .art__cta p { font-family: var(--font-display); font-size: 1.375rem; }
</style>
