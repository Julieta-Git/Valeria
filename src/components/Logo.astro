---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-valeria.png';
// Logo del salón. Cuando llegue el archivo original (SVG o PNG sin fondo), reemplazar src/assets/brand/logo-valeria.png.
interface Props { size?: 'm' | 'l' }
const { size = 'm' } = Astro.props;
const width = size === 'l' ? 200 : 96;
---
<a href="/" class:list={['logo', `logo--${size}`]}>
  <Image src={logo} alt="Valeria, salón de belleza unisex" width={width} densities={[1, 2]} loading={size === 'm' ? 'eager' : 'lazy'} />
</a>
<style>
  .logo { display: inline-block; line-height: 0; }
  .logo img { width: auto; height: auto; }
  @media (max-width: 40rem) { .logo--m img { width: 72px; } }
  .logo:hover img { filter: brightness(1.12); }
</style>
