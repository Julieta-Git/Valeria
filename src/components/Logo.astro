---
// Logotipo provisorio en texto hasta recibir el logo real (SVG).
interface Props { size?: 'm' | 'l' }
const { size = 'm' } = Astro.props;
---
<a href="/" class:list={['logo', `logo--${size}`]} aria-label="Valeria Salón de Belleza, inicio">
  <span class="logo__name">Valeria</span>
  <span class="logo__sub">Salón de Belleza</span>
</a>
<style>
  .logo { display: inline-flex; flex-direction: column; text-decoration: none; color: var(--text); line-height: 1; }
  .logo__name { font-family: var(--font-script); font-size: 2.1rem; line-height: 0.9; }
  .logo__sub { font-size: 0.625rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--text-soft); margin-top: 0.35rem; padding-left: 0.2rem; }
  .logo--l .logo__name { font-size: 3rem; }
  .logo:hover { color: var(--text); }
  .logo:hover .logo__name { color: var(--accent-text); }
</style>
