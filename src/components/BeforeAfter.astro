---
import Foto from './Foto.astro';
// antes / despues: ruta de la foto dentro de src/assets/fotos/ (o vacío mientras no esté).
interface Props { descripcion: string; servicio?: string | null; ratio?: string; antes?: string | null; despues?: string | null }
const { descripcion, servicio, ratio = '4 / 5', antes, despues } = Astro.props;
---
<figure class="ba-fig">
  <div class="ba">
    <Foto src={antes} label="Antes" alt={`${descripcion}: antes`} ratio={ratio} sizes="(min-width: 60rem) 25vw, 50vw" />
    <Foto src={despues} label="Después" alt={`${descripcion}: después`} ratio={ratio} sizes="(min-width: 60rem) 25vw, 50vw" />
    <span class="ba__label ba__label--before">Antes</span>
    <span class="ba__label ba__label--after">Después</span>
  </div>
  <figcaption class="small muted">
    {descripcion}{servicio && <> · <a href={`/servicios/${servicio}`}>ver servicio</a></>}
  </figcaption>
</figure>
<style>
  .ba-fig { margin: 0; display: flex; flex-direction: column; gap: var(--s1); }
  .ba-fig figcaption a { display: inline-block; padding-block: 0.7rem; }
</style>
