---
import { enlaceWhatsApp } from '../lib/whatsapp';
interface Props { label?: string; mensaje?: string; variant?: 'primary' | 'ghost'; small?: boolean }
const { label = 'Escribinos por WhatsApp', mensaje = 'Hola Valeria, quería hacerte una consulta.', variant = 'ghost', small = true } = Astro.props;
---
<a href={enlaceWhatsApp(mensaje)} target="_blank" rel="noopener" class:list={['btn', `btn--${variant}`, { 'btn--small': small }, 'wa-btn']}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 20l1.3-3.9A8 8 0 1 1 8 19.1L4 20z" />
    <path d="M9.2 9.3c.2 1.6 1.9 3.4 3.5 3.8l.9-.9 1.6.7-.3 1.3c-2.7.3-6.3-3-6.1-6l1.3-.3.7 1.6-.9.9" />
  </svg>
  {label}
</a>
<style>
  .wa-btn { align-self: flex-start; }
</style>
